[Unit]
Description=Fast-mode RandomX share verifier for xmrig-proxy
After=local-fs.target
Before=xmrig-proxy.service

[Service]
Type=simple
User=xmrig-verifier
Group=xmrig
WorkingDirectory=/opt/xmrig-randomx-verifier
ExecStart=/usr/bin/node /opt/xmrig-randomx-verifier/src/index.js
ExecStartPost=/usr/bin/node /opt/xmrig-randomx-verifier/examples/wait-ready.js
Environment=UV_THREADPOOL_SIZE=4
EnvironmentFile=-/etc/default/xmrig-randomx-verifier

RuntimeDirectory=xmrig-randomx-verifier
RuntimeDirectoryMode=0750
UMask=0117

Restart=on-failure
RestartSec=2s
TimeoutStopSec=60s
KillSignal=SIGTERM
LimitNOFILE=4096
TasksMax=128

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ReadWritePaths=/run/xmrig-randomx-verifier
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes

# RandomX JIT needs executable mappings; enabling this would break hashing.
MemoryDenyWriteExecute=no

[Install]
WantedBy=multi-user.target
