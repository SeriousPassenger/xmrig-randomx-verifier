# Four VMs reached about 1.14 kH/s on the Xeon E3-1240 v5 test host.
UV_THREADPOOL_SIZE=4
VM_POOL_SIZE=4
INIT_THREADS=4

VERIFIER_SOCKET_PATH=/run/xmrig-randomx-verifier/verifier.sock
ENABLE_HUGE_PAGES=false
VERIFY_QUEUE_LIMIT=256
MAX_BLOB_BYTES=4096
HANDSHAKE_TIMEOUT_MS=5000
WRITE_STALL_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=30000
READY_TIMEOUT_MS=15000

# Normally leave this unset. The default is VERIFY_QUEUE_LIMIT + VM_POOL_SIZE + 16.
# MAX_PENDING_PER_CLIENT=276
